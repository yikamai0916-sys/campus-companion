{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "campus-companion",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": true},
  "d1_databases": [{"binding": "DB", "database_name": "REPLACE_WITH_YOUR_D1_DATABASE_NAME", "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID", "migrations_dir": "migrations"}],
  "ai": {"binding": "AI"},
  "triggers": {"crons": ["* * * * *"]},
  "vars": {
    "LOGIN_EMAIL": "owner@example.com",
    "OWNER_EMAIL": "outlook@example.com",
    "SCHOOL_EMAIL": "student@university.example",
    "MS_CLIENT_ID": "REPLACE_WITH_YOUR_MICROSOFT_APP_CLIENT_ID",
    "APP_ORIGIN": "https://your-worker.your-subdomain.workers.dev",
    "ENABLE_AI": "false"
  }
}
